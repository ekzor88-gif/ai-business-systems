---
import Layout from '../../components/Layout.astro';
import { siteConfig } from '../../config/site.js';

const cases = [
  {
    id: 'greenleaf',
    title: 'AI-консультант для GreenLeaf',
    subtitle: 'Семантический поиск по каталогу 370+ товаров',
    category: 'AI-интеграция',
    problem: `GreenLeaf — сеть магазинов фиточаев и БАДов с каталогом из 370+ товаров, большинство из которых имеют длинные описания с составами и показаниями. Сотрудники постоянно отвечают на повторяющиеся вопросы и не всегда знают всю информацию о каждом товаре.`,
    solution: `Разработан Telegram-бот с семантическим поиском по каталогу:
- Векторная база данных на Supabase + pgvector
- Интеграция структуры данных из каталога GoodsFlow
- Ускорение консультаций за счёт мгновенного поиска`,
    result: `Консультанты быстро находят информацию о составе и показаниях товаров без необходимости запоминать весь каталог.`,
    tech: ['Python', 'Telegram Bot', 'Supabase', 'pgvector', 'Semantic Search'],
    tags: ['AI', 'Telegram', 'RAG'],
  },
  {
    id: 'erp-cleanup',
    title: 'Очистка и автоматизация в ERP',
    subtitle: 'Устранение дублей, пробросы данных, ускорение рутинных операций',
    category: 'Data & ERP',
    problem: `Крупная компания с десятками тысяч записей в ERP-системе: дубли контрагентов, ручное заполнение карточек, рассинхрон между системами. Сотрудники тратят десятки часов в неделю на рутинные операции с данными.`,
    solution: `Проведена комплексная очистка и автоматизация:
- Очистка дублей контрагентов и товаров
- Настройка автоматических пробросов между системами
- Приведение базы в консистентное состояние`,
    result: `Значительная экономия времени сотрудников — десятки, а в некоторых операциях сотни часов ручного труда в месяц возвращены бизнесу.`,
    tech: ['Python', 'ERP API', 'Data Pipeline', 'Automation'],
    tags: ['ERP', 'Data Cleanup', 'Automation'],
  },
  {
    id: 'fmcg-analytics',
    title: 'Аналитика план-факт для FMCG',
    subtitle: 'Автоматизация отчётности и Excel-дашбордов',
    category: 'Аналитика',
    problem: `Цифра — план-факт собирается вручную: десятки Excel-файлов, ручные переносы, потери времени на сведение данных. Аналитики тратят дни вместо часов на подготовку отчётов.`,
    solution: `Разработана система автоматической сборки отчётов:
- Автоматический сбор данных из источников
- Автоматизация Excel-отчётов
- Визуализация план-факт отклонений`,
    result: `Сокращение времени подготовки отчётов, ускорение принятия решений на основе актуальных данных.`,
    tech: ['Python', 'Excel Automation', 'Data Analytics', 'Dashboards'],
    tags: ['Analytics', 'Excel', 'Automation'],
  },
];
---

<Layout title="Кейсы — AiOps & Automation" description="Практические примеры внедрения автоматизации и AI-интеграций">
  <div class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero -->
      <div class="max-w-3xl mb-16">
        <p class="text-accent text-sm font-semibold uppercase tracking-wider mb-3">Кейсы</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6">
          Практические примеры
        </h1>
        <p class="text-gray-400 text-lg leading-relaxed">
          Реальные задачи и решения. Без фантастических цифр — только то, что было сделано и работает.
        </p>
      </div>

      <!-- Cases -->
      <div class="space-y-16">
        {cases.map((caseItem) => (
          <article class="glass p-8 lg:p-12">
            <!-- Header -->
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-medium">{caseItem.category}</span>
              <div class="flex flex-wrap gap-2">
                {caseItem.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-white/5 text-gray-400 text-xs">{tag}</span>
                ))}
              </div>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2">{caseItem.title}</h2>
            <p class="text-gray-400 text-base mb-8">{caseItem.subtitle}</p>

            <!-- Problem → Solution → Result -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
              <div>
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Проблема</h3>
                <p class="text-gray-300 text-sm leading-relaxed whitespace-pre-line">{caseItem.problem}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Решение</h3>
                <p class="text-gray-300 text-sm leading-relaxed whitespace-pre-line">{caseItem.solution}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Результат</h3>
                <p class="text-gray-300 text-sm leading-relaxed">{caseItem.result}</p>
              </div>
            </div>

            <!-- Tech stack -->
            <div class="mt-8 pt-6 border-t border-white/5">
              <p class="text-xs text-gray-500 font-medium uppercase tracking-wider mb-3">Стек</p>
              <div class="flex flex-wrap gap-2">
                {caseItem.tech.map((t) => (
                  <span class="px-3 py-1 rounded-md bg-white/5 text-gray-400 text-xs font-mono">{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center glass p-10">
        <h3 class="text-2xl font-bold text-white mb-3">Есть похожая задача?</h3>
        <p class="text-gray-400 mb-6">Расскажите про ваш кейс — обсудим подход и сроки.</p>
        <a href="/#contacts" class="inline-flex items-center px-6 py-3 rounded-xl bg-accent hover:bg-accent-dark text-dark-900 font-semibold transition-all duration-200">
          Обсудить задачу
        </a>
      </div>
    </div>
  </div>
</Layout>
