{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectSchema",
  "description": "Схема описания отдельного проекта в рамках инженерной базы знаний",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Уникальный идентификатор проекта"
    },
    "name": {
      "type": "string",
      "description": "Понятное имя проекта"
    },
    "description": {
      "type": "string",
      "description": "Техническое описание назначения проекта"
    },
    "role": {
      "type": "string",
      "description": "Роль разработчика в проекте"
    },
    "project_type": {
      "type": "string",
      "description": "Тип проекта (commercial, pet_project, open_source)"
    },
    "status": {
      "type": "string",
      "description": "Текущий статус проекта"
    },
    "start_date": {
      "type": "string",
      "description": "Дата начала участия YYYY-MM"
    },
    "end_date": {
      "type": "string",
      "description": "Дата окончания участия YYYY-MM"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Использованные технологии"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "metric": { "type": "string" },
          "value": { "type": "string" },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric_type": { "type": "string" },
                "before": { "type": "string" },
                "after": { "type": "string" },
                "unit": { "type": "string" },
                "improvement_percent": { "type": "number" },
                "confidence": { "type": "number" }
              },
              "required": ["metric_type", "unit"]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "source": { "type": "string" },
                "location": { "type": "string" },
                "description": { "type": "string" }
              },
              "required": ["id", "type", "source"]
            }
          }
        },
        "required": ["description"]
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "diagram_mermaid": { "type": "string" },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["pattern"]
    },
    "lessons_learned": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "category": { "type": "string" },
              "statement": { "type": "string" },
              "context": { "type": "string" },
              "resolution": { "type": "string" }
            },
            "required": ["id", "category", "statement"]
          }
        ]
      }
    },
    "repositories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["id", "name", "description", "technologies", "achievements", "repository_url"]
}
